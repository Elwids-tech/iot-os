execute_process(COMMAND ${NM} -S ${PROBE} OUTPUT_VARIABLE probe)
string(REGEX MATCH "[0-9a-fA-F]+ ([0-9a-fA-F]+) [BbCc] iotos_size_probe" match "${probe}")
if(NOT match)
  message(FATAL_ERROR "Could not read sizeof(iotos_gateway) from ${PROBE}")
endif()
math(EXPR gateway "0x${CMAKE_MATCH_1}" OUTPUT_FORMAT DECIMAL)

execute_process(COMMAND ${SIZE} -t ${LIBRARY} OUTPUT_VARIABLE sizes)
string(REGEX MATCH "\n *([0-9]+)[ \t]+([0-9]+)[ \t]+([0-9]+)[ \t]+[0-9]+[ \t]+[0-9a-fA-F]+[ \t]+\\(TOTALS\\)" totals "${sizes}")
if(NOT totals)
  message(FATAL_ERROR "Could not read the section sizes of ${LIBRARY}")
endif()
set(text ${CMAKE_MATCH_1})
set(data ${CMAKE_MATCH_2})
set(bss ${CMAKE_MATCH_3})

execute_process(COMMAND ${NM} -u ${LIBRARY} OUTPUT_VARIABLE undefined)
string(REGEX MATCHALL "[ \t]U (malloc|calloc|realloc|free)\n" heap "${undefined}")

message(STATUS "sizeof(iotos_gateway): ${gateway} bytes (limit 32768)")
message(STATUS "libiotos.a: text ${text}, data ${data}, bss ${bss} bytes")
set(failed "")
if(gateway GREATER 32768)
  string(APPEND failed " iotos_gateway is larger than 32 KiB.")
endif()
if(NOT data EQUAL 0 OR NOT bss EQUAL 0)
  string(APPEND failed " The library has writable static data; state belongs in iotos_gateway.")
endif()
if(heap)
  string(APPEND failed " The library references the heap:${heap}")
endif()
if(failed)
  message(FATAL_ERROR "${failed}")
endif()
