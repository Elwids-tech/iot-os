{
  "schema": "iot.native-mqtt-binding.authoring.v1",
  "binding": {
    "uuid": "44444444-4444-4444-8444-444444444441",
    "profile_uuid": "33333333-3333-4333-8333-333333333331",
    "key": "native_mqtt_events_v1",
    "name": "Native MQTT event array",
    "description": "Dispatches bounded event records using the manufacturer type field.",
    "transport": "native_mqtt_json"
  },
  "version": {
    "uuid": "44444444-4444-4444-8444-444444444442",
    "profile_version_uuid": "33333333-3333-4333-8333-333333333332",
    "version": 1,
    "notes": "Golden multi-event fixture.",
    "channels": [
      {
        "uuid": "44444444-4444-4444-8444-444444444443",
        "key": "events",
        "label": "Events",
        "purpose": "event",
        "direction": "device_to_platform",
        "topic_template": "devices/{device_id}/events",
        "qos": 1,
        "retain": false,
        "content_type": "application/json",
        "record_path": "$.events[*]",
        "max_records": 100,
        "envelope": {
          "device_id": {
            "scope": "payload",
            "json_path": "$.device_id"
          },
          "observed_at": {
            "path": {
              "scope": "record",
              "json_path": "$.timestamp"
            },
            "format": "rfc3339"
          }
        }
      }
    ],
    "telemetry_mappings": [],
    "property_mappings": [],
    "event_mappings": [
      {
        "uuid": "44444444-4444-4444-8444-444444444444",
        "channel": "events",
        "target": "safety.door_opened",
        "discriminator": {
          "path": {
            "scope": "record",
            "json_path": "$.type"
          },
          "equals": "door_opened"
        },
        "field_mappings": [
          {
            "target": "door",
            "source": {
              "scope": "record",
              "json_path": "$.door"
            },
            "wire_data_type": "string",
            "missing_policy": "reject_message"
          }
        ]
      },
      {
        "uuid": "44444444-4444-4444-8444-444444444445",
        "channel": "events",
        "target": "safety.overheat",
        "discriminator": {
          "path": {
            "scope": "record",
            "json_path": "$.type"
          },
          "equals": "overheat"
        },
        "field_mappings": [
          {
            "target": "temperature",
            "source": {
              "scope": "record",
              "json_path": "$.temperature"
            },
            "wire_data_type": "float64",
            "missing_policy": "reject_message"
          }
        ]
      }
    ],
    "command_mappings": []
  }
}
