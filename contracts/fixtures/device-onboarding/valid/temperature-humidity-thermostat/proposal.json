              "path": {"scope": "payload", "json_path": "$.timestamp"},
              "format": "rfc3339"
            }
          }
        },
        {
          "uuid": "44444444-4444-4444-8444-444444444444",
          "key": "set_temperature_request",
          "label": "Set temperature request",
          "purpose": "command_request",
          "direction": "platform_to_device",
          "topic_template": "devices/{device_id}/commands/set_temperature/request",
          "qos": 1,
          "retain": false,
          "content_type": "application/json",
          "record_path": "$",
          "max_records": 1,
          "envelope": {}
        },
        {
          "uuid": "44444444-4444-4444-8444-444444444445",
          "key": "set_temperature_response",
          "label": "Set temperature response",
          "purpose": "command_response",
          "direction": "device_to_platform",
          "topic_template": "devices/{device_id}/commands/set_temperature/response",
          "qos": 1,
          "retain": false,
          "content_type": "application/json",
          "record_path": "$",
          "max_records": 1,
          "envelope": {
            "device_id": {"scope": "payload", "json_path": "$.device_id"},
            "observed_at": {
              "path": {"scope": "payload", "json_path": "$.timestamp"},
              "format": "rfc3339"
            }
          }
        }
      ],
      "telemetry_mappings": [
        {
          "uuid": "44444444-4444-4444-8444-444444444446",
          "channel": "telemetry",
          "target": "temperature",
          "source": {"scope": "record", "json_path": "$.temperature"},
          "wire_data_type": "float64",
          "missing_policy": "reject_message"
        },
        {
          "uuid": "44444444-4444-4444-8444-444444444447",
          "channel": "telemetry",
          "target": "humidity",
          "source": {"scope": "record", "json_path": "$.humidity"},
          "wire_data_type": "float64",
          "missing_policy": "reject_message"
        }
      ],
      "property_mappings": [],
      "event_mappings": [],
      "command_mappings": [
        {
          "uuid": "44444444-4444-4444-8444-444444444448",
          "target": "set_temperature",
          "request_channel": "set_temperature_request",
          "response_channel": "set_temperature_response",
          "request_template": {},
          "request_envelope": {
            "command_id_path": "$.command_id",
            "device_id_path": "$.device_id",
            "requested_at_path": "$.timestamp"
          },
          "response": {
            "correlation": {"scope": "payload", "json_path": "$.command_id"},
            "status": {
              "path": {"scope": "payload", "json_path": "$.status"},
              "values": {
                "accepted": ["accepted"],
                "running": ["running"],
                "succeeded": ["succeeded"],
                "failed": ["failed", "rejected"]
              }
            }
          },
          "field_mappings": [
            {
              "direction": "input",
              "target": "temp_level",
              "json_path": "$.temp_level",
              "wire_data_type": "float64",
              "missing_policy": "reject_message"
