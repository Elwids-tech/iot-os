            {
              "uuid": "33333333-3333-4333-8333-333333333334",
              "key": "temperature",
              "label": "Temperature",
              "description": "Measured ambient temperature.",
              "value_schema": {
                "data_type": "float64",
                "unit_code": "Cel",
                "required": true,
                "critical": true,
                "constraints": {"minimum": -40, "maximum": 125},
                "display": {"order": 10, "precision": 1}
              }
