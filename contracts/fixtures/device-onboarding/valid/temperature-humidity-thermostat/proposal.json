        {
          "uuid": "44444444-4444-4444-8444-444444444443",
          "key": "telemetry",
          "label": "Telemetry",
          "purpose": "telemetry",
          "direction": "device_to_platform",
          "topic_template": "devices/{device_id}/telemetry",
          "qos": 1,
          "retain": false,
          "content_type": "application/json",
          "record_path": "$",
          "max_records": 1,
          "envelope": {
            "device_id": {"scope": "payload", "json_path": "$.device_id"},
