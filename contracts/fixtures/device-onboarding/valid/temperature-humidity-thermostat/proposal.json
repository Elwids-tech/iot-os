      "key": "native_mqtt_v1",
      "name": "Native MQTT firmware v1",
      "description": "Firmware-owned MQTT JSON mapping proposed by the assistant.",
      "transport": "native_mqtt_json"
    },
    "version": {
      "uuid": "44444444-4444-4444-8444-444444444442",
      "profile_version_uuid": "33333333-3333-4333-8333-333333333332",
      "version": 1,
      "notes": "Editable AI-assisted onboarding draft.",
