{
  "schema": "iot.native-mqtt-binding.authoring.v1",
  "binding": {
    "uuid": "22222222-2222-4222-8222-222222222221",
    "profile_uuid": "11111111-1111-4111-8111-111111111111",
    "key": "native_mqtt_v1",
    "name": "Native MQTT firmware v1",
    "description": "Firmware-owned MQTT JSON mapping for the golden onboarding fixture.",
    "transport": "native_mqtt_json"
  },
  "version": {
    "uuid": "22222222-2222-4222-8222-222222222222",
    "profile_version_uuid": "11111111-1111-4111-8111-111111111112",
    "version": 1,
    "notes": "Golden onboarding fixture.",
    "channels": [
      {
        "uuid": "22222222-2222-4222-8222-222222222223",
        "key": "telemetry",
        "label": "Telemetry",
        "purpose": "telemetry",
        "direction": "device_to_platform",
        "topic_template": "devices/{device_id}/telemetry",
        "qos": 1,
        "retain": false,
        "content_type": "application/json",
        "record_path": "$",
        "max_records": 1,
        "envelope": {
          "device_id": {
            "scope": "payload",
            "json_path": "$.device_id"
          },
          "observed_at": {
            "path": {
              "scope": "payload",
              "json_path": "$.timestamp"
            },
            "format": "rfc3339"
          }
        }
      },
      {
        "uuid": "22222222-2222-4222-8222-222222222224",
        "key": "set_temperature_request",
        "label": "Set temperature request",
        "purpose": "command_request",
        "direction": "platform_to_device",
        "topic_template": "devices/{device_id}/commands/set_temperature/request",
        "qos": 1,
        "retain": false,
        "content_type": "application/json",
        "record_path": "$",
        "max_records": 1,
        "envelope": {}
      },
      {
        "uuid": "22222222-2222-4222-8222-222222222225",
        "key": "set_temperature_response",
        "label": "Set temperature response",
        "purpose": "command_response",
        "direction": "device_to_platform",
        "topic_template": "devices/{device_id}/commands/set_temperature/response",
        "qos": 1,
        "retain": false,
        "content_type": "application/json",
        "record_path": "$",
        "max_records": 1,
        "envelope": {
          "device_id": {
            "scope": "payload",
            "json_path": "$.device_id"
          },
          "observed_at": {
            "path": {
              "scope": "payload",
              "json_path": "$.timestamp"
            },
            "format": "rfc3339"
          }
        }
      }
    ],
    "telemetry_mappings": [
      {
        "uuid": "22222222-2222-4222-8222-222222222226",
        "channel": "telemetry",
        "target": "environment.temperature",
        "source": {
          "scope": "record",
          "json_path": "$.temperature"
        },
        "wire_data_type": "float64",
        "missing_policy": "reject_message"
      },
      {
        "uuid": "22222222-2222-4222-8222-222222222227",
        "channel": "telemetry",
        "target": "environment.humidity",
        "source": {
          "scope": "record",
          "json_path": "$.humidity"
        },
        "wire_data_type": "float64",
        "missing_policy": "reject_message"
      }
    ],
    "property_mappings": [],
    "event_mappings": [],
    "command_mappings": [
      {
        "uuid": "22222222-2222-4222-8222-222222222228",
        "target": "thermostat.set_temperature",
        "request_channel": "set_temperature_request",
        "response_channel": "set_temperature_response",
        "request_template": {},
        "request_envelope": {
          "command_id_path": "$.command_id",
          "device_id_path": "$.device_id",
          "requested_at_path": "$.timestamp"
        },
        "response": {
          "correlation": {
            "scope": "payload",
            "json_path": "$.command_id"
          },
          "status": {
            "path": {
              "scope": "payload",
              "json_path": "$.status"
            },
            "values": {
              "accepted": ["accepted"],
              "running": ["running"],
              "succeeded": ["succeeded"],
              "failed": ["failed", "rejected"]
            }
          }
        },
        "field_mappings": [
          {
            "direction": "input",
            "target": "temp_level",
            "json_path": "$.temp_level",
            "wire_data_type": "float64",
            "missing_policy": "reject_message"
          },
          {
            "direction": "output",
            "target": "applied_temp_level",
            "json_path": "$.applied_temp_level",
            "wire_data_type": "float64",
            "missing_policy": "omit_value"
          }
        ]
      }
    ]
  }
}
