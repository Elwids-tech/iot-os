{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/devices/v1/telemetry.schema.json",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "definition": {
      "$ref": "configuration.schema.json"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "readings": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "parameter_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "enum": [
              "boolean",
              "integer",
              "number",
              "string",
              "timestamp",
              "bytes"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "quality": {
            "enum": [
              "good",
              "invalid",
              "stale"
            ]
          },
          "diagnostic": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "historical": {
            "type": "boolean"
          },
          "timestamp_source": {
            "enum": [
              "source",
              "receipt",
              "corrected_future",
              "derived"
            ]
          }
        },
        "required": [
          "parameter_uuid",
          "key",
          "label",
          "data_type",
          "unit",
          "value",
          "quality",
          "observed_at",
          "received_at",
          "historical"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "uuid",
    "definition",
    "session_id",
    "readings"
  ],
  "additionalProperties": false
}
