{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "device.activate.v1"
    },
    "payload": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "definition": {
          "oneOf": [
            {
              "$ref": "configuration.schema.json"
            },
            {
              "$ref": "../v2/configuration.schema.json"
            }
          ]
        }
      },
      "required": [
        "generation",
        "definition"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "uuid",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
