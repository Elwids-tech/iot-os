{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/devices/v2/configuration.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "device-configuration.v2"
    },
    "configuration_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "device_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "organization_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "profile_artifact_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_canonical_json": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "connection_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "candidate_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "edge_node_id": {
          "type": "string",
          "minLength": 1
        },
        "device_id": {
          "type": "string"
        }
      },
      "required": [
        "connection_uuid",
        "candidate_uuid",
        "group_id",
        "edge_node_id",
        "device_id"
      ],
      "additionalProperties": false
    },
    "birth_revision": {
      "type": "integer",
      "minimum": 1
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "parameter_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "datatype": {
            "type": "string",
            "minLength": 1
          },
          "command_metric": {
            "type": [
              "string",
              "null"
            ]
          },
          "command_datatype": {
            "type": [
              "string",
              "null"
            ]
          },
          "conversion_mode": {
            "description": "How the incoming conversion was chosen. Laravel's configuration compiler always sends it; configurations written by the GPS demo seeder omit it. The runtime reads an absent value as profile.",
            "enum": [
              "profile",
              "custom",
              "none"
            ]
          },
          "ingress_conversion": {
            "description": "The effective incoming conversion, null when none applies. Laravel's configuration compiler always sends it; the GPS demo seeder's configurations omit it, and the runtime drops it when null as it re-encodes a definition for the internal telemetry message. Absent means null.",
            "$ref": "#/$defs/ingress_conversion"
          }
        },
        "required": [
          "parameter_uuid",
          "metric",
          "datatype",
          "command_metric",
          "command_datatype"
        ],
        "additionalProperties": false
      }
    },
    "adapter": {
      "description": "Adapter-backed devices only: the hardware installation this configuration was compiled for, written by Laravel from platform enrollment, never from the vendor payload. The runtime accepts adapter readings only when their metric provenance names installation_uuid, and copies the binding into each reading.",
      "type": "object",
      "properties": {
        "installation_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "manufacturer_serial": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "installation_uuid",
        "adapter_uuid",
        "manufacturer_serial"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "configuration_uuid",
    "device_uuid",
    "organization_uuid",
    "profile_artifact_uuid",
    "profile_hash",
    "profile_canonical_json",
    "source",
    "birth_revision",
    "mappings"
  ],
  "additionalProperties": false,
  "$defs": {
    "ingress_conversion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "source_unit": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255
            },
            "multiplier": {
              "type": "number",
              "not": {
                "const": 0
              }
            },
            "offset": {
              "type": "number"
            }
          },
          "required": [
            "multiplier",
            "offset"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
