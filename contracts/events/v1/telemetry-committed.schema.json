{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/events/v1/telemetry-committed.schema.json",
  "description": "telemetry.committed.v1: readings after telemetry storage commits, published by the runtime's committed relay on iot.committed.telemetry.v1. Producer: runtime (devices-storage writes device_runtime.telemetry_outbox; the relay sets sequence). Consumers: workflow-evaluator-v1 and other trusted services such as cmd/committed-consumer. At least once; deduplicate by event_id. Readings of adapter devices carry installation_uuid, adapter_revision_uuid and manufacturer_serial when their provenance matches the adapter binding.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "telemetry.committed.v1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "telemetry_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "organization_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "device_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "configuration_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "parameter_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "enum": [
              "boolean",
              "integer",
              "number",
              "string",
              "timestamp",
              "bytes",
              "enum"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "quality": {
            "enum": [
              "good",
              "invalid",
              "stale"
            ]
          },
          "diagnostic": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "historical": {
            "type": "boolean"
          },
          "timestamp_source": {
            "enum": [
              "source",
              "receipt",
              "corrected_future",
              "derived"
            ]
          },
          "installation_uuid": {
            "type": "string",
            "format": "uuid",
            "description": "Adapter devices only: the enrolled installation, from the device's adapter binding, when the reading's provenance matches it."
          },
          "adapter_revision_uuid": {
            "type": "string",
            "format": "uuid",
            "description": "Adapter devices only: the adapter revision the managed publisher reported for the metric."
          },
          "manufacturer_serial": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Adapter devices only: the physical source's serial from the adapter binding."
          }
        },
        "required": [
          "parameter_uuid",
          "key",
          "data_type",
          "unit",
          "value",
          "quality",
          "observed_at",
          "received_at",
          "historical"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "telemetry_id",
    "sequence",
    "organization_uuid",
    "device_uuid",
    "configuration_uuid",
    "generation",
    "readings"
  ],
  "additionalProperties": false
}
