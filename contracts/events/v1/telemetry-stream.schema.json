{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/events/v1/telemetry-stream.schema.json",
  "description": "telemetry-stream.v1: one committed telemetry event of one granted device as the application telemetry stream carries it (spec 030, ADR-032). Derived from telemetry.committed.v1 by dropping telemetry_id, organization_uuid, installation_uuid, adapter_revision_uuid, manufacturer_serial, timestamp_source and diagnostic. Producer: the runtime's stream handler, relayed by Laravel as the SSE `reading` event whose `id` equals `position`. Consumer: applications and the integration SDK. At least once across reconnections; deduplicate by event_id.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "telemetry-stream.v1"
    },
    "position": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "The committed sequence, opaque to clients; `0` only ever appears in an `open` event."
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "configuration_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "parameter_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "enum": [
              "boolean",
              "integer",
              "number",
              "string",
              "timestamp",
              "bytes",
              "enum"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "quality": {
            "enum": [
              "good",
              "invalid",
              "stale"
            ],
            "description": "A reading other than `good` was stored as a diagnostic, not as an observation."
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "historical": {
            "type": "boolean"
          }
        },
        "required": [
          "parameter_uuid",
          "key",
          "data_type",
          "unit",
          "value",
          "quality",
          "observed_at",
          "received_at",
          "historical"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "position",
    "event_id",
    "device_uuid",
    "configuration_uuid",
    "generation",
    "readings"
  ],
  "additionalProperties": false
}
