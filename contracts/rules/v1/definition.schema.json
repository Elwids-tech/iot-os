{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/rules/v1/definition.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "geofence-rule.v1"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "version_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "evaluator_version": {
      "const": "geofence.v1"
    },
    "pipeline": {
      "const": [
        "location.source.v1",
        "geofence.membership.v1",
        "condition.sustained.v1",
        "alert.condition.v1"
      ]
    },
    "binding": {
      "$ref": "https://iot-os.local/contracts/location/v1/binding.schema.json"
    },
    "geometry": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 257,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -75,
                  "maximum": 75
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "outside_for_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "max_gap_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "minimum_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "uncertainty_metres": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "outside_for_seconds",
        "max_gap_seconds",
        "minimum_samples",
        "uncertainty_metres"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "uuid",
    "version_uuid",
    "evaluator_version",
    "pipeline",
    "binding",
    "geometry",
    "policy"
  ],
  "additionalProperties": false
}
