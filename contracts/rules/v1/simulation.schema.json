{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/rules/v1/simulation.schema.json",
  "type": "object",
  "properties": {
    "definition": {
      "$ref": "https://iot-os.local/contracts/rules/v1/definition.schema.json"
    },
    "state": {
      "$ref": "https://iot-os.local/contracts/rules/v1/state.schema.json"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "anyOf": [
              {
                "$ref": "https://iot-os.local/contracts/events/v1/telemetry-committed.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "at",
          "event"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "definition",
    "steps"
  ],
  "additionalProperties": false
}
