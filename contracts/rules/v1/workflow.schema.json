{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/rules/v1/workflow.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "automation-workflow.v1"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "version_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "const": "location.source.v1"
              },
              "config": {
                "type": "object",
                "properties": {
                  "binding": {
                    "$ref": "https://iot-os.local/contracts/location/v1/binding.schema.json"
                  }
                },
                "required": [
                  "binding"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "const": "geofence.membership.v1"
              },
              "config": {
                "type": "object",
                "properties": {
                  "geometry": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "Polygon"
                      },
                      "coordinates": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "array",
                          "minItems": 4,
                          "maxItems": 257,
                          "items": {
                            "type": "array",
                            "prefixItems": [
                              {
                                "type": "number",
                                "minimum": -180,
                                "maximum": 180
                              },
                              {
                                "type": "number",
                                "minimum": -75,
                                "maximum": 75
                              }
                            ],
                            "minItems": 2,
                            "maxItems": 2
                          }
                        }
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ],
                    "additionalProperties": false
                  },
                  "uncertainty_metres": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100000
                  }
                },
                "required": [
                  "geometry",
                  "uncertainty_metres"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "const": "condition.sustained.v1"
              },
              "config": {
                "type": "object",
                "properties": {
                  "outside_for_seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 86400
                  },
                  "max_gap_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "minimum_samples": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                },
                "required": [
                  "outside_for_seconds",
                  "max_gap_seconds",
                  "minimum_samples"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "type": {
                "const": "alert.condition.v1"
              },
              "config": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "config"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "source",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "uuid",
    "version_uuid",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
