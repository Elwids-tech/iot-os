{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "uuid",
    "version_uuid",
    "organization_uuid",
    "bindings",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "automation-workflow.v2"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "version_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "organization_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "device_uuid",
          "configuration_uuid",
          "generation",
          "parameter_uuid",
          "data_type",
          "unit",
          "fresh_seconds"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "device_uuid": {
            "type": "string"
          },
          "configuration_uuid": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "parameter_uuid": {
            "type": "string"
          },
          "data_type": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "fresh_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "config"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string"
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "source_port",
          "target",
          "target_port"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "source_port": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "target_port": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "https://iot-os.local/contracts/rules/v2/workflow.schema.json"
}
