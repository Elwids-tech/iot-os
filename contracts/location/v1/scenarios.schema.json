{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/location/v1/scenarios.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "location-scenarios.v1"
    },
    "test_parameters": {
      "type": "object",
      "properties": {
        "interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "accuracy_metres": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "interval_seconds",
        "accuracy_metres"
      ],
      "additionalProperties": false
    },
    "reference_polygon": {
      "type": "object",
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "binding": {
            "$ref": "https://iot-os.local/contracts/location/v1/binding.schema.json"
          },
          "event": {
            "$ref": "https://iot-os.local/contracts/events/v1/telemetry-committed.schema.json"
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expected": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "valid",
                  "unknown"
                ]
              },
              "reason": {
                "enum": [
                  "scope_mismatch",
                  "ambiguous_parameters",
                  "incomplete_fix",
                  "incoherent_fix",
                  "invalid_quality",
                  "invalid_coordinates",
                  "invalid_units",
                  "invalid_time",
                  "future_time",
                  "untrusted_time",
                  "incoherent_accuracy",
                  "invalid_accuracy",
                  "accuracy_required",
                  "historical",
                  "stale_fix",
                  "eligible"
                ]
              },
              "live_eligible": {
                "type": "boolean"
              }
            },
            "required": [
              "status",
              "reason",
              "live_eligible"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "binding",
          "event",
          "evaluated_at",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "test_parameters",
    "reference_polygon",
    "cases"
  ],
  "additionalProperties": false
}
