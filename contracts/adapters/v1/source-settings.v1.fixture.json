{
  "type": "poll",
  "request": {
    "method": "GET",
    "url": "https://api.example.com/accounts/A1/streams/history",
    "query": [
      {"name": "start", "value": "{cursor}"},
      {"name": "end", "value": "{now}"}
    ],
    "headers": [],
    "body": null
  },
  "credentials": {"placement": "header", "name": "x-api-key"},
  "time_format": "iso",
  "interval_seconds": 300,
  "page": {"size": 500, "size_param": "limit", "more": "full_page", "max_pages": 20},
  "records": "/data",
  "cursor": {"kind": "timestamp", "pointer": "/maxDate", "lag_seconds": null},
  "initial_lookback_seconds": 3600
}
