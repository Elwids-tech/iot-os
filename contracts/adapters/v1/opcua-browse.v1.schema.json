{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/adapters/v1/opcua-browse.v1.schema.json",
  "title": "OPC UA browse page",
  "description": "What /opcua/browse answers: up to 200 children of a node and a cursor for the next page, or a problem. Producer: services/adapters/lib/opcua/browse.cjs. Consumer: Connections in apps/api.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    },
    "problem": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "items",
    "cursor"
  ],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 4096,
          "pattern": "^(i|s|g|b)="
        },
        "namespace_uri": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "display_name": {
          "type": "string",
          "maxLength": 512
        },
        "kind": {
          "enum": [
            "folder",
            "object",
            "point"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "has_children": {
          "type": "boolean"
        }
      },
      "required": [
        "node_id",
        "namespace_uri",
        "name",
        "display_name",
        "kind",
        "type",
        "has_children"
      ],
      "additionalProperties": false
    }
  }
}
