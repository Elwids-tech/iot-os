{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/adapters/v1/opcua-search.v1.schema.json",
  "title": "OPC UA search",
  "description": "What /opcua/search answers: nodes whose name contains the text within a branch, with their path, how many nodes were visited, and whether the scan stopped at its 20,000-node limit. Producer: services/adapters/lib/opcua/browse.cjs. Consumer: Connections in apps/api.",
  "type": "object",
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4096,
            "pattern": "^(i|s|g|b)="
          },
          "namespace_uri": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "display_name": {
            "type": "string",
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "folder",
              "object",
              "point"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "has_children": {
            "type": "boolean"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/segment"
            }
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "node_id",
          "namespace_uri",
          "name",
          "display_name",
          "kind",
          "type",
          "has_children",
          "path",
          "source_id"
        ],
        "additionalProperties": false
      }
    },
    "visited": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "matches",
    "visited",
    "truncated"
  ],
  "additionalProperties": false,
  "$defs": {
    "segment": {
      "type": "object",
      "properties": {
        "namespace_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "namespace_uri",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
