{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-os.local/contracts/adapters/v1/runtime-event.v1.schema.json",
  "title": "Tenant runtime event",
  "description": "A callback from an adapter's tenant runtime. Producer: the Reporter node of the tenant runtime (services/adapters/nodes/adapter.js), to POST /api/internal/adapters/events with the tenant runtime token and an X-Adapter-Tenant header. Consumer: Laravel (AdapterController::event). `kind` selects the event. Kinds connection_status, refused_points and server_certificate come from an OPC UA source (spec 038): the state of the server connection, the points it would not collect, and a server certificate that no longer matches the accepted one. Delivery: poll_run, outcomes, refused_points and server_certificate are kept and retried until Laravel accepts them (at most 100 queued); sample, health, diagnostic and failure are best effort, and failure is throttled to one per 2 seconds per adapter. Deduplication keys: poll_run by run_id (an upsert), failure by report_id, outcomes by report_id; sample replaces the candidate of its source_device_id, health and connection_status keep the latest values, refused_points replaces the adapter's previous list, and server_certificate by its fingerprint. Fencing: an event whose revision_uuid is neither the applied nor the desired revision is dropped with 204. Read tolerantly by Laravel.",
  "oneOf": [
    {
      "type": "object",
      "description": "A decoded device seen by the adapter: it becomes or refreshes a discovered device.",
      "properties": {
        "kind": {
          "const": "sample"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "source_device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sparkplug_device_id": {
          "type": "string",
          "pattern": "^src-[0-9a-f]{32}$",
          "description": "src- and the first 32 hex characters of the SHA-256 of source_device_id; Laravel refuses any other value."
        },
        "preview": {
          "type": "object",
          "description": "A validated decoder result: decoder-output.v1 plus the profile's datatype, parameter_uuid and unit for each metric. A connector source adds each metric's quality and reason, and the result's timestampSource; a bad value is null.",
          "properties": {
            "sourceDeviceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "metrics": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2000,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": [
                      "number",
                      "integer",
                      "boolean",
                      "string",
                      "null"
                    ],
                    "maxLength": 16384
                  },
                  "datatype": {
                    "enum": [
                      "Double",
                      "Int64",
                      "Boolean",
                      "String"
                    ]
                  },
                  "parameter_uuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "quality": {
                    "enum": [
                      "good",
                      "uncertain",
                      "bad"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 300
                  }
                },
                "required": [
                  "name",
                  "value",
                  "datatype",
                  "parameter_uuid",
                  "unit"
                ],
                "additionalProperties": false
              }
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "timestampSource": {
              "enum": [
                "source",
                "server",
                "receipt"
              ]
            }
          },
          "required": [
            "sourceDeviceId",
            "metrics"
          ],
          "additionalProperties": false
        },
        "retained": {
          "type": "boolean"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "source_device_id",
        "sparkplug_device_id",
        "preview",
        "retained",
        "received_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Connection state. The source sends source_connected (and source_state for polling), the publisher upstream_connected.",
      "properties": {
        "kind": {
          "const": "health"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "source_connected": {
          "type": "boolean"
        },
        "upstream_connected": {
          "type": "boolean"
        },
        "source_state": {
          "enum": [
            "polling",
            "retrying",
            "stopped"
          ]
        }
      },
      "required": [
        "kind",
        "adapter_uuid"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "source_connected"
          ]
        },
        {
          "required": [
            "upstream_connected"
          ]
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "diagnostic"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "One polling run; it updates the adapter's polling state.",
      "properties": {
        "kind": {
          "const": "poll_run"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "ok",
            "empty",
            "partial",
            "retrying",
            "stopped"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "published": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "cursor_before": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "cursor_after": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "committed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "state": {
          "enum": [
            "polling",
            "retrying",
            "stopped"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "description": "Why polling stopped, when it did."
        },
        "next_attempt_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "run_id",
        "started_at",
        "finished_at",
        "outcome",
        "pages",
        "records",
        "published",
        "failed",
        "duplicates",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "An input that failed decoding or validation, kept 7 days as a failed delivery.",
      "properties": {
        "kind": {
          "const": "failure"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "report_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "enum": [
            "mqtt",
            "webhook",
            "poll"
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "enum": [
            "decode_failed",
            "validation_failed"
          ]
        },
        "error": {
          "type": "string",
          "maxLength": 300
        },
        "input": {
          "type": "object",
          "description": "The failed input in the shape of a test fixture, so a person can turn it into a sample.",
          "properties": {
            "topic": {
              "type": "string",
              "maxLength": 65535
            },
            "payload_base64": {
              "type": "string",
              "maxLength": 21848,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$",
              "description": "At most the first 16 KiB of the input body."
            },
            "truncated": {
              "const": true
            },
            "source": {
              "enum": [
                "mqtt",
                "webhook",
                "poll"
              ]
            },
            "received_at": {
              "type": "string",
              "format": "date-time"
            },
            "http": {
              "$ref": "https://iot-os.local/contracts/adapters/v1/decoder-input.v1.schema.json#/$defs/http"
            },
            "poll": {
              "$ref": "https://iot-os.local/contracts/adapters/v1/decoder-input.v1.schema.json#/$defs/poll"
            }
          },
          "required": [
            "topic",
            "payload_base64",
            "source",
            "received_at"
          ],
          "additionalProperties": false
        },
        "delivery_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "report_id",
        "source",
        "received_at",
        "reason",
        "error",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Decoder and publisher outcome counts since the last report, added to the hour's counts.",
      "properties": {
        "kind": {
          "const": "outcomes"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "report_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "bucket": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00\\.000Z$",
          "description": "The start of the UTC hour the counts belong to."
        },
        "counts": {
          "type": "object",
          "properties": {
            "decoded": {
              "type": "integer",
              "minimum": 1
            },
            "decode_failed": {
              "type": "integer",
              "minimum": 1
            },
            "validation_failed": {
              "type": "integer",
              "minimum": 1
            },
            "duplicate": {
              "type": "integer",
              "minimum": 1
            },
            "historical": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "report_id",
        "bucket",
        "counts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "The state of the OPC UA server connection this adapter reads through, sent when it changes and every minute while collecting.",
      "properties": {
        "kind": {
          "const": "connection_status"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "connection_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "connected",
            "unreachable",
            "stopped"
          ],
          "description": "stopped: the runtime will not try again until the connection is changed (a changed server certificate)."
        },
        "reason": {
          "enum": [
            "unreachable",
            "address_not_allowed",
            "no_shared_security",
            "server_certificate_changed",
            "client_certificate_untrusted",
            "sign_in_refused",
            "server_busy",
            "clock_difference",
            "timeout",
            null
          ],
          "description": "Why it is not connected; null when connected."
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "fix": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300,
          "description": "What to do about the reason, as the connection test says it."
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "security": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "policy": {
              "type": "string",
              "maxLength": 64
            },
            "mode": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "policy",
            "mode"
          ],
          "additionalProperties": false
        },
        "points_read": {
          "type": "integer",
          "minimum": 0,
          "description": "Points collected, by subscription or at the rhythm."
        },
        "points_bad": {
          "type": "integer",
          "minimum": 0,
          "description": "Of those, points whose latest value is bad."
        },
        "values_last_minute": {
          "type": "integer",
          "minimum": 0
        },
        "clock_difference_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "limits": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "integer",
              "null"
            ]
          },
          "description": "The server's announced operation limits, by their OPC UA names."
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "connection_uuid",
        "state",
        "reason",
        "since",
        "points_read",
        "points_bad",
        "values_last_minute"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "The points this adapter's point map names that the server refused or the connector cannot collect; replaces the adapter's previous list.",
      "properties": {
        "kind": {
          "const": "refused_points"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "connection_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "points": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "source_id",
              "key",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "polled": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "source_id",
              "key",
              "reason"
            ],
            "additionalProperties": false
          },
          "description": "Points beyond the server's monitored item limit, read at the rhythm instead."
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "connection_uuid",
        "points",
        "polled"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "The server presented a certificate other than the accepted one; collecting through this connection has stopped.",
      "properties": {
        "kind": {
          "const": "server_certificate"
        },
        "adapter_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "revision_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "connection_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "presented": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "maxLength": 1024
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "valid_from": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "valid_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "application_uri": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1024
            },
            "der": {
              "type": "string",
              "maxLength": 16384,
              "contentEncoding": "base64"
            }
          },
          "required": [
            "subject",
            "fingerprint",
            "valid_from",
            "valid_to",
            "application_uri",
            "der"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "adapter_uuid",
        "connection_uuid",
        "presented"
      ],
      "additionalProperties": false
    }
  ]
}
