{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-os.dev/definitions/device-profile/v1/authoring.schema.json",
  "title": "Device Profile authoring contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "version"],
  "properties": {
    "schema": {"const": "iot.device-profile.authoring.v1"},
    "profile": {"$ref": "#/$defs/Profile"},
    "version": {"$ref": "#/$defs/ProfileVersion"}
  },
  "$defs": {
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000}
      }
    },
    "ProfileVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "components"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "version": {"type": "integer", "minimum": 1},
        "notes": {"type": ["string", "null"], "maxLength": 4000},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/Component"}
        }
      }
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "telemetry", "properties", "events", "commands"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "../../common/v1/schema.json#/$defs/Key"}
          ]
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "telemetry": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/Telemetry"}
        },
        "properties": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/Property"}
        },
        "events": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/Event"}
        },
        "commands": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/Command"}
        }
      }
    },
    "Telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "value_schema"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "value_schema": {"$ref": "../../common/v1/schema.json#/$defs/ValueSchema"},
        "derivation": {"$ref": "#/$defs/Derivation"}
      }
    },
    "Derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cel", "dependencies"],
      "properties": {
        "cel": {"$ref": "../../common/v1/schema.json#/$defs/CelExpression"},
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "../../common/v1/schema.json#/$defs/QualifiedKey"}
        }
      }
    },
    "Property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "scope", "value_schema"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "scope": {"$ref": "../../common/v1/schema.json#/$defs/PropertyScope"},
        "value_schema": {"$ref": "../../common/v1/schema.json#/$defs/ValueSchema"},
        "acknowledgement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {
            "required": {"type": "boolean"},
            "reported_property_key": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "../../common/v1/schema.json#/$defs/QualifiedKey"}
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"type": "object", "required": ["scope"], "properties": {"scope": {"const": "desired"}}},
          "then": {},
          "else": {"type": "object", "properties": {"acknowledgement": false}}
        }
      ]
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "mode", "default_severity", "fields"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "mode": {"$ref": "../../common/v1/schema.json#/$defs/EventMode"},
        "default_severity": {"$ref": "../../common/v1/schema.json#/$defs/EventSeverity"},
        "dedupe_window_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400},
        "fields": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/EventField"}
        }
      }
    },
    "EventField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "value_schema"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "value_schema": {"$ref": "../../common/v1/schema.json#/$defs/ValueSchema"}
      }
    },
    "Command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "mode",
        "risk",
        "timeout_seconds",
        "offline_policy",
        "idempotent",
        "max_attempts",
        "fields"
      ],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "mode": {"$ref": "../../common/v1/schema.json#/$defs/CommandMode"},
        "risk": {"$ref": "../../common/v1/schema.json#/$defs/CommandRisk"},
        "confirmation_text": {"type": ["string", "null"], "maxLength": 1000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "offline_policy": {"$ref": "../../common/v1/schema.json#/$defs/CommandOfflinePolicy"},
        "idempotent": {"type": "boolean"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "fields": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/CommandField"}
        }
      },
      "allOf": [
        {
          "if": {"type": "object", "required": ["mode"], "properties": {"mode": {"const": "two_way"}}},
          "then": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": ["direction"],
                  "properties": {"direction": {"const": "output"}}
                }
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"direction": {"not": {"const": "output"}}}
                }
              }
            }
          }
        },
        {
          "if": {"type": "object", "required": ["risk"], "properties": {"risk": {"enum": ["medium", "high"]}}},
          "then": {
            "type": "object",
            "required": ["confirmation_text"],
            "properties": {"confirmation_text": {"type": "string", "minLength": 1}}
          }
        },
        {
          "if": {"type": "object", "required": ["idempotent"], "properties": {"idempotent": {"const": false}}},
          "then": {"type": "object", "properties": {"max_attempts": {"const": 1}}}
        }
      ]
    },
    "CommandField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "key", "label", "value_schema"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "direction": {"$ref": "../../common/v1/schema.json#/$defs/CommandFieldDirection"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "value_schema": {"$ref": "../../common/v1/schema.json#/$defs/ValueSchema"}
      }
    }
  }
}
