{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-os.dev/definitions/runtime-bundle/v1/schema.json",
  "title": "Route-aware Device Runtime Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_bundle_hash",
    "organization_uuid",
    "gateway_uuid",
    "gateway_route_uuid",
    "route_revision",
    "route_path",
    "device_uuid",
    "profile_uuid",
    "profile_version_uuid",
    "binding_uuid",
    "binding_version_uuid",
    "profile_artifact_hash",
    "binding_artifact_hash",
    "route_source_hash",
    "compiler",
    "channels",
    "parameter_pipelines",
    "derived_pipelines",
    "command_pipelines"
  ],
  "properties": {
    "schema": {
      "const": "iot.runtime-bundle.v1"
    },
    "runtime_bundle_hash": {
      "$ref": "../../common/v1/schema.json#/$defs/Sha256"
    },
    "organization_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "gateway_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "gateway_route_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "route_revision": {
      "type": "integer",
      "minimum": 1
    },
    "route_path": {
      "$ref": "../../common/v1/schema.json#/$defs/RoutePath"
    },
    "device_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "profile_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "profile_version_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "binding_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "binding_version_uuid": {
      "$ref": "../../common/v1/schema.json#/$defs/Uuid"
    },
    "profile_artifact_hash": {
      "$ref": "../../common/v1/schema.json#/$defs/Sha256"
    },
    "binding_artifact_hash": {
      "$ref": "../../common/v1/schema.json#/$defs/Sha256"
    },
    "route_source_hash": {
      "$ref": "../../common/v1/schema.json#/$defs/Sha256"
    },
    "compiler": {
      "$ref": "../../common/v1/schema.json#/$defs/CompilerMetadata"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/ResolvedChannel"
      }
    },
    "parameter_pipelines": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/ParameterPipeline"
      }
    },
    "derived_pipelines": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/DerivedPipeline"
      }
    },
    "command_pipelines": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/CommandPipeline"
      }
    }
  },
  "$defs": {
    "ResolvedTopic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*[{}+#]).+$"
    },
    "ResolvedChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_uuid",
        "key",
        "purpose",
        "direction",
        "topic",
        "qos",
        "retain",
        "record_path",
        "max_records",
        "envelope"
      ],
      "properties": {
        "channel_uuid": {
          "$ref": "../../common/v1/schema.json#/$defs/Uuid"
        },
        "key": {
          "$ref": "../../common/v1/schema.json#/$defs/Key"
        },
        "purpose": {
          "$ref": "../../common/v1/schema.json#/$defs/BindingPurpose"
        },
        "direction": {
          "$ref": "../../common/v1/schema.json#/$defs/BindingDirection"
        },
        "topic": {
          "$ref": "#/$defs/ResolvedTopic"
        },
        "qos": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "retain": {
          "type": "boolean"
        },
        "record_path": {
          "$ref": "../../common/v1/schema.json#/$defs/RecordPath"
        },
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "envelope": {
          "$ref": "../../native-mqtt-binding/v1/authoring.schema.json#/$defs/Envelope"
        },
        "route_payload_path": {
          "$ref": "../../common/v1/schema.json#/$defs/JsonPath"
        },
        "route_selector": {
          "$ref": "../../gateway-route/v1/authoring.schema.json#/$defs/RouteSelector"
        }
      }
    },
    "ParameterPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping",
        "target_data_type"
      ],
      "properties": {
        "mapping": {
          "$ref": "../../native-mqtt-binding/v1/authoring.schema.json#/$defs/ParameterMapping"
        },
        "target_data_type": {
          "$ref": "../../common/v1/schema.json#/$defs/DataType"
        }
      }
    },
    "DerivedPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_uuid",
        "target_data_type",
        "expression",
        "dependency_parameter_uuids",
        "evaluation_order"
      ],
      "properties": {
        "parameter_uuid": {
          "$ref": "../../common/v1/schema.json#/$defs/Uuid"
        },
        "target_data_type": {
          "$ref": "../../common/v1/schema.json#/$defs/DataType"
        },
        "expression": {
          "$ref": "../../device-profile/v1/authoring.schema.json#/$defs/DerivedExpression"
        },
        "dependency_parameter_uuids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "../../common/v1/schema.json#/$defs/Uuid"
          }
        },
        "evaluation_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "CommandPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_uuid",
        "mapping_uuid",
        "request_topic",
        "mapping"
      ],
      "properties": {
        "command_uuid": {
          "$ref": "../../common/v1/schema.json#/$defs/Uuid"
        },
        "mapping_uuid": {
          "$ref": "../../common/v1/schema.json#/$defs/Uuid"
        },
        "request_topic": {
          "$ref": "#/$defs/ResolvedTopic"
        },
        "response_topic": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ResolvedTopic"
            }
          ]
        },
        "mapping": {
          "$ref": "../../native-mqtt-binding/v1/authoring.schema.json#/$defs/CommandMapping"
        }
      }
    }
  }
}
