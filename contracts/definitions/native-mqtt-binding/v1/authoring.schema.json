{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-os.dev/definitions/native-mqtt-binding/v1/authoring.schema.json",
  "title": "Native MQTT JSON Binding authoring contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding", "version"],
  "properties": {
    "schema": {"const": "iot.native-mqtt-binding.authoring.v1"},
    "binding": {"$ref": "#/$defs/Binding"},
    "version": {"$ref": "#/$defs/BindingVersion"}
  },
  "$defs": {
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_uuid", "key", "name", "transport"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "profile_uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "description": {"type": ["string", "null"], "maxLength": 4000},
        "transport": {"const": "native_mqtt_json"}
      }
    },
    "BindingVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version_uuid",
        "version",
        "channels",
        "telemetry_mappings",
        "property_mappings",
        "event_mappings",
        "command_mappings"
      ],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "profile_version_uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "version": {"type": "integer", "minimum": 1},
        "notes": {"type": ["string", "null"], "maxLength": 4000},
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/Channel"}
        },
        "telemetry_mappings": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/TelemetryMapping"}
        },
        "property_mappings": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/PropertyMapping"}
        },
        "event_mappings": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/EventMapping"}
        },
        "command_mappings": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/CommandMapping"}
        }
      }
    },
    "Channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "purpose",
        "direction",
        "topic_template",
        "qos",
        "retain",
        "content_type",
        "record_path",
        "max_records",
        "envelope"
      ],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "key": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "purpose": {"$ref": "../../common/v1/schema.json#/$defs/BindingPurpose"},
        "direction": {"$ref": "../../common/v1/schema.json#/$defs/BindingDirection"},
        "topic_template": {"$ref": "../../common/v1/schema.json#/$defs/TopicTemplate"},
        "qos": {"type": "integer", "enum": [0, 1]},
        "retain": {"type": "boolean"},
        "content_type": {"const": "application/json"},
        "record_path": {"$ref": "../../common/v1/schema.json#/$defs/RecordPath"},
        "max_records": {"type": "integer", "minimum": 1, "maximum": 100},
        "envelope": {"$ref": "#/$defs/Envelope"}
      }
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_id": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
        "observed_at": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format"],
          "properties": {
            "path": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
            "format": {"$ref": "../../common/v1/schema.json#/$defs/TimestampFormat"}
          }
        },
        "message_id": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"}
      }
    },
    "TelemetryMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "target", "source", "wire_data_type", "missing_policy"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "channel": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "target": {"$ref": "../../common/v1/schema.json#/$defs/QualifiedKey"},
        "source": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
        "wire_data_type": {"$ref": "../../common/v1/schema.json#/$defs/DataType"},
        "transform": {"$ref": "../../common/v1/schema.json#/$defs/Transform"},
        "missing_policy": {"$ref": "../../common/v1/schema.json#/$defs/MissingPolicy"},
        "default_value": true
      },
      "allOf": [
        {
          "if": {"type": "object", "required": ["missing_policy"], "properties": {"missing_policy": {"const": "use_default"}}},
          "then": {"type": "object", "required": ["default_value"], "properties": {"default_value": true}},
          "else": {"type": "object", "properties": {"default_value": false}}
        }
      ]
    },
    "PropertyMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "target", "direction", "json_path", "wire_data_type", "missing_policy"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "channel": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "target": {"$ref": "../../common/v1/schema.json#/$defs/QualifiedKey"},
        "direction": {"type": "string", "enum": ["extract", "place"]},
        "json_path": {"$ref": "../../common/v1/schema.json#/$defs/JsonPath"},
        "source_scope": {"$ref": "../../common/v1/schema.json#/$defs/PathScope"},
        "wire_data_type": {"$ref": "../../common/v1/schema.json#/$defs/DataType"},
        "transform": {"$ref": "../../common/v1/schema.json#/$defs/Transform"},
        "missing_policy": {"$ref": "../../common/v1/schema.json#/$defs/MissingPolicy"},
        "default_value": true
      },
      "allOf": [
        {
          "if": {"type": "object", "required": ["missing_policy"], "properties": {"missing_policy": {"const": "use_default"}}},
          "then": {"type": "object", "required": ["default_value"], "properties": {"default_value": true}},
          "else": {"type": "object", "properties": {"default_value": false}}
        }
      ]
    },
    "EventMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "target", "field_mappings"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "channel": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "target": {"$ref": "../../common/v1/schema.json#/$defs/QualifiedKey"},
        "discriminator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "equals"],
          "properties": {
            "path": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
            "equals": {"type": ["string", "number", "integer", "boolean"]}
          }
        },
        "event_id": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
            "transform": {"$ref": "../../common/v1/schema.json#/$defs/Transform"}
          }
        },
        "field_mappings": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/EventFieldMapping"}
        }
      }
    },
    "EventFieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "source", "wire_data_type", "missing_policy"],
      "properties": {
        "target": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "source": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
        "wire_data_type": {"$ref": "../../common/v1/schema.json#/$defs/DataType"},
        "transform": {"$ref": "../../common/v1/schema.json#/$defs/Transform"},
        "missing_policy": {"$ref": "../../common/v1/schema.json#/$defs/MissingPolicy"},
        "default_value": true
      },
      "allOf": [
        {
          "if": {"type": "object", "required": ["missing_policy"], "properties": {"missing_policy": {"const": "use_default"}}},
          "then": {"type": "object", "required": ["default_value"], "properties": {"default_value": true}},
          "else": {"type": "object", "properties": {"default_value": false}}
        }
      ]
    },
    "CommandMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "request_channel", "request_template", "request_envelope", "field_mappings"],
      "properties": {
        "uuid": {"$ref": "../../common/v1/schema.json#/$defs/Uuid"},
        "target": {"$ref": "../../common/v1/schema.json#/$defs/QualifiedKey"},
        "request_channel": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "response_channel": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "../../common/v1/schema.json#/$defs/Key"}
          ]
        },
        "request_template": {"type": "object"},
        "request_envelope": {"$ref": "#/$defs/CommandRequestEnvelope"},
        "response": {"$ref": "#/$defs/CommandResponse"},
        "field_mappings": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/CommandFieldMapping"}
        }
      }
    },
    "CommandRequestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id_path"],
      "properties": {
        "command_id_path": {"$ref": "../../common/v1/schema.json#/$defs/JsonPath"},
        "device_id_path": {"$ref": "../../common/v1/schema.json#/$defs/JsonPath"},
        "requested_at_path": {"$ref": "../../common/v1/schema.json#/$defs/JsonPath"},
        "expires_at_path": {"$ref": "../../common/v1/schema.json#/$defs/JsonPath"}
      }
    },
    "CommandResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation", "status"],
      "properties": {
        "correlation": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "values"],
          "properties": {
            "path": {"$ref": "../../common/v1/schema.json#/$defs/PathRef"},
            "transform": {"$ref": "../../common/v1/schema.json#/$defs/Transform"},
            "values": {
              "type": "object",
              "additionalProperties": false,
              "required": ["succeeded", "failed"],
              "properties": {
                "accepted": {"$ref": "#/$defs/StatusValues"},
                "running": {"$ref": "#/$defs/StatusValues"},
                "succeeded": {"$ref": "#/$defs/StatusValues"},
                "failed": {"$ref": "#/$defs/StatusValues"}
              }
            }
          }
        }
      }
    },
    "StatusValues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": ["string", "number", "integer", "boolean"]}
    },
    "CommandFieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "target", "json_path", "wire_data_type", "missing_policy"],
      "properties": {
        "direction": {"$ref": "../../common/v1/schema.json#/$defs/CommandFieldDirection"},
        "target": {"$ref": "../../common/v1/schema.json#/$defs/Key"},
        "json_path": {"$ref": "../../common/v1/schema.json#/$defs/JsonPath"},
        "wire_data_type": {"$ref": "../../common/v1/schema.json#/$defs/DataType"},
        "transform": {"$ref": "../../common/v1/schema.json#/$defs/Transform"},
        "missing_policy": {"$ref": "../../common/v1/schema.json#/$defs/MissingPolicy"},
        "default_value": true
      },
      "allOf": [
        {
          "if": {"type": "object", "required": ["missing_policy"], "properties": {"missing_policy": {"const": "use_default"}}},
          "then": {"type": "object", "required": ["default_value"], "properties": {"default_value": true}},
          "else": {"type": "object", "properties": {"default_value": false}}
        }
      ]
    }
  }
}
