{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-os.dev/definitions/gateway/v2/authoring.schema.json",
  "title": "Gateway authoring contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gateway"
  ],
  "properties": {
    "schema": {
      "const": "iot.gateway.authoring.v2"
    },
    "gateway": {
      "$ref": "#/$defs/Gateway"
    }
  },
  "$defs": {
    "Gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "key",
        "name",
        "mqtt_client_id"
      ],
      "properties": {
        "uuid": {
          "$ref": "../../common/v2/schema.json#/$defs/Uuid"
        },
        "key": {
          "$ref": "../../common/v2/schema.json#/$defs/Key"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "mqtt_client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^+#\\u0000]+$"
        }
      }
    }
  }
}
