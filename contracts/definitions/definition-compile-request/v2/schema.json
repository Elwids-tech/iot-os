{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-os.dev/definitions/definition-compile-request/v2/schema.json",
  "title": "Route-aware Device definition compile request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "organization_uuid",
    "profile",
    "binding",
    "gateway",
    "route",
    "fixtures"
  ],
  "properties": {
    "schema": {
      "const": "iot.definition-compile-request.v2"
    },
    "organization_uuid": {
      "$ref": "../../common/v2/schema.json#/$defs/Uuid"
    },
    "profile": {
      "$ref": "../../device-profile/v2/authoring.schema.json"
    },
    "binding": {
      "$ref": "../../native-mqtt-binding/v2/authoring.schema.json"
    },
    "gateway": {
      "$ref": "../../gateway/v2/authoring.schema.json"
    },
    "route": {
      "$ref": "../../gateway-route/v2/authoring.schema.json"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/Fixture"
      }
    }
  },
  "$defs": {
    "Fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "channel",
        "topic",
        "payload"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": [
            "telemetry",
            "event",
            "property",
            "command_request",
            "command_response"
          ]
        },
        "channel": {
          "$ref": "../../common/v2/schema.json#/$defs/Key"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "payload": true,
        "command_input": {
          "type": "object"
        },
        "expected_parameter_values": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/ExpectedParameterValue"
          }
        }
      }
    },
    "ExpectedParameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_uuid",
        "value"
      ],
      "properties": {
        "parameter_uuid": {
          "$ref": "../../common/v2/schema.json#/$defs/Uuid"
        },
        "value": true
      }
    }
  }
}
