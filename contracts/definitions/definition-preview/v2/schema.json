{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iot-os.dev/definitions/definition-preview/v2/schema.json",
  "title": "Route-aware Device definition compile preview v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "valid",
    "input_hash",
    "compiler",
    "diagnostics",
    "artifact_hashes",
    "previews"
  ],
  "properties": {
    "schema": {
      "const": "iot.definition-preview.v2"
    },
    "valid": {
      "type": "boolean"
    },
    "input_hash": {
      "$ref": "../../common/v2/schema.json#/$defs/Sha256"
    },
    "compiler": {
      "$ref": "../../common/v2/schema.json#/$defs/CompilerMetadata"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "../../common/v2/schema.json#/$defs/Diagnostic"
      }
    },
    "artifact_hashes": {
      "$ref": "#/$defs/ArtifactHashes"
    },
    "profile_artifact": {
      "$ref": "../../device-profile/v2/artifact.schema.json"
    },
    "binding_artifact": {
      "$ref": "../../native-mqtt-binding/v2/artifact.schema.json"
    },
    "runtime_bundle": {
      "$ref": "../../runtime-bundle/v2/schema.json"
    },
    "previews": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/FixturePreview"
      }
    }
  },
  "$defs": {
    "ArtifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "binding",
        "runtime_bundle"
      ],
      "properties": {
        "profile": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../common/v2/schema.json#/$defs/Sha256"
            }
          ]
        },
        "binding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../common/v2/schema.json#/$defs/Sha256"
            }
          ]
        },
        "runtime_bundle": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "../../common/v2/schema.json#/$defs/Sha256"
            }
          ]
        }
      }
    },
    "FixturePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "accepted",
        "values",
        "diagnostics"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "accepted": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/PreviewValue"
          }
        },
        "encoded_payload": true,
        "diagnostics": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "../../common/v2/schema.json#/$defs/Diagnostic"
          }
        }
      }
    },
    "PreviewValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_uuid",
        "value_type",
        "value",
        "quality"
      ],
      "properties": {
        "parameter_uuid": {
          "$ref": "../../common/v2/schema.json#/$defs/Uuid"
        },
        "value_type": {
          "$ref": "../../common/v2/schema.json#/$defs/DataType"
        },
        "value": true,
        "quality": {
          "$ref": "../../canonical-telemetry/v2/schema.json#/$defs/Quality"
        }
      }
    }
  }
}
