{
  "name": "@iot-os/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "generate:device-domain": "pnpm run generate:device-domain:v1 && pnpm run generate:device-domain:v2",
    "generate:device-domain:v1": "openapi-typescript ../../contracts/openapi/device-domain.v1.yaml --output ./src/device-domain.generated.ts",
    "generate:device-domain:v2": "openapi-typescript ../../contracts/openapi/device-domain.v2.yaml --output ./src/device-domain-v2.generated.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
