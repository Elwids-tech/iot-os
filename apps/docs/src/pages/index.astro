---
// The platform's front door at the root of the platform domain (US4, FR-020, FR-022):
// who runs it, what it is, and the ways in. It names no industry products, outcome
// figures or customers, and links only to pages that are built and published.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { getCollection } from 'astro:content'
import Build from '../components/landing/Build.astro'
import Hero from '../components/landing/Hero.astro'
import LandingFooter from '../components/landing/LandingFooter.astro'
import Layers from '../components/landing/Layers.astro'
import Steps from '../components/landing/Steps.astro'
import { docsConfig } from '../../docs.config'

// A page appears only once it exists and isn't a draft.
const docs = await getCollection('docs')
const published = (id: string) => Boolean(docs.find((entry) => entry.id === id && !entry.data.draft))
const guide = (slug: string) => published(`docs/guides/${slug}`)

const connect = published('docs/get-started/connect-a-device')
const integrate = published('docs/get-started/build-an-integration')

const actions = [
  { label: 'Sign in', href: docsConfig.portalUrl, tone: 'primary' as const },
  ...(connect ? [{ label: 'Connect a device', href: '/docs/get-started/connect-a-device/', tone: 'secondary' as const }] : []),
  ...(integrate ? [{ label: 'Build an integration', href: '/docs/get-started/build-an-integration/', tone: 'secondary' as const }] : []),
  { label: 'Read the docs', href: '/docs/', tone: connect || integrate ? ('plain' as const) : ('secondary' as const) },
  { label: 'API reference', href: '/docs/reference/api/', tone: 'plain' as const },
]

const facts = [
  ...(guide('discovery') ? [{ label: 'Devices', text: 'Sparkplug B over MQTT with TLS', href: '/docs/guides/discovery/' }] : []),
  { label: 'Applications', text: 'Integration API and signed webhooks', href: '/docs/reference/api/' },
  ...(guide('dashboards') ? [{ label: 'People', text: 'Dashboards, alerts and automations', href: '/docs/guides/dashboards/' }] : []),
]

const developerLinks = [
  ...(connect ? [{ title: 'Connect your first device', text: 'Run a simulated Sparkplug B device and watch its readings arrive.', href: '/docs/get-started/connect-a-device/' }] : []),
  ...(integrate ? [{ title: 'Build your first integration', text: 'List devices, read values and verify a webhook with the SDK.', href: '/docs/get-started/build-an-integration/' }] : []),
  { title: 'Integration API reference', text: 'Every operation an application can call, with the abilities it needs and its rate limits.', href: '/docs/reference/api/' },
  { title: 'Events and webhooks', text: 'Follow alerts, geofences and automations through the ordered feed or signed webhooks.', href: '/docs/developers/events/' },
  ...(guide('getting-started') ? [{ title: 'User guides', text: 'The guides people read inside the portal, for devices, profiles, dashboards and alerts.', href: '/docs/guides/getting-started/' }] : []),
  { title: 'Changelog', text: 'What changed for applications in each release.', href: '/docs/changelog/' },
]

const footerColumns = [
  {
    title: 'Platform',
    links: [
      { label: 'Sign in', href: docsConfig.portalUrl },
      { label: 'Documentation', href: '/docs/' },
      ...(guide('getting-started') ? [{ label: 'User guides', href: '/docs/guides/getting-started/' }] : []),
      { label: 'Changelog', href: '/docs/changelog/' },
    ],
  },
  {
    title: 'Developers',
    links: [
      ...(connect ? [{ label: 'Connect a device', href: '/docs/get-started/connect-a-device/' }] : []),
      ...(integrate ? [{ label: 'Build an integration', href: '/docs/get-started/build-an-integration/' }] : []),
      { label: 'API reference', href: '/docs/reference/api/' },
      { label: 'Events and webhooks', href: '/docs/developers/events/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: `${docsConfig.companyName} website`, href: docsConfig.marketingUrl },
      { label: 'Contact', href: docsConfig.contactUrl },
    ],
  },
]
---

<StarlightPage
  frontmatter={{
    title: `${docsConfig.companyName}: ${docsConfig.companyTagline}`,
    description: `${docsConfig.productName} is the platform ${docsConfig.companyName} builds connected operations on. Sign in, or read the developer docs.`,
    template: 'splash',
    pagefind: false,
  }}
>
  <Hero actions={actions} facts={facts} />
  <Layers />
  <Steps />
  <Build links={developerLinks} />
  <LandingFooter columns={footerColumns} />
</StarlightPage>

<style>
  /* The hero is full-bleed and starts right under the header: hide the empty title
     panel (the hero has the h1) and keep the negative margins from scrolling sideways. */
  :global(body:has([data-hero])) { overflow-x: clip; }
  :global(.content-panel:has(> .sl-container:empty)) { display: none; }
  :global(.content-panel:has([data-hero])) { padding-top: 0; border-top: 0; }
  /* The landing page sits on the brand ink, edge to edge. */
  :global(body:has([data-hero])),
  :global(body:has([data-hero]) .main-frame) { background: var(--brand-ink); }
</style>
