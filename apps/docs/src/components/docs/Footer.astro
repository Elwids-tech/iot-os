---
// Starlight's footer, plus a way to report a problem with the page (FR-017). The
// report goes to the company website's contact page with the page address.
import Default from '@astrojs/starlight/components/Footer.astro'
import { docsConfig } from '../../../docs.config'

const report = new URL(docsConfig.contactUrl)
report.searchParams.set('type', 'question')
report.searchParams.set('page', Astro.url.pathname)
---

<Default />
<p class="report-problem"><a href={report.toString()}>Report a problem with this page</a></p>
