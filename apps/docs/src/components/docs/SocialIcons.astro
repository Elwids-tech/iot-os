---
// Header links (FR-002): the company website and the portal's sign-in, next to
// Starlight's own social links.
import Default from '@astrojs/starlight/components/SocialIcons.astro'
import { docsConfig } from '../../../docs.config'
---

<nav class="sl-header-links" aria-label="Elsewhere">
  <a href={docsConfig.marketingUrl}>{docsConfig.companyName} website</a>
  <a class="sign-in" href={docsConfig.portalUrl}>Sign in</a>
</nav>
<Default />
