---
// The landing page's closing call to action and footer. Every link goes to the
// portal, a published docs page or the company website.
import { docsConfig } from '../../../docs.config'

interface Column { title: string; links: { label: string; href: string }[] }
interface Props { columns: Column[] }
const { columns } = Astro.props
---

<section class="cta not-content reveal" aria-labelledby="cta-title">
  <h2 id="cta-title">Ready to look at your own data?</h2>
  <p>Sign in to your organization, or talk to {docsConfig.companyName} about connecting your sites.</p>
  <div class="actions">
    <a class="action primary" href={docsConfig.portalUrl}>Sign in</a>
    <a class="action secondary" href={docsConfig.contactUrl}>Contact {docsConfig.companyName}</a>
  </div>
</section>

<footer class="landing-footer not-content">
  <div class="brand">
    <a class="brand-link" href={docsConfig.marketingUrl}>
      <span class="brand-wordmark">{docsConfig.companyName}</span>
    </a>
    <p>{docsConfig.companyTagline}</p>
    <p class="company">
      {docsConfig.productName} is built and run by {docsConfig.companyName}, who use it to build connected operations
      with their customers.
    </p>
  </div>
  {
    columns.map((column) => (
      <nav aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))
  }
  <p class="legal">© {new Date().getFullYear()} {docsConfig.companyName}</p>
</footer>

<style>
  .cta {
    max-width: 72rem;
    margin: clamp(4rem, 10vh, 6.5rem) auto 0;
    padding: clamp(2rem, 6vw, 3.5rem) 1.5rem;
    border-radius: 1.75rem;
    background:
      radial-gradient(60% 120% at 50% 0%, color-mix(in oklab, var(--brand-to) 22%, transparent), transparent 70%),
      linear-gradient(135deg, color-mix(in oklab, var(--brand-from) 14%, var(--brand-surface)), var(--brand-surface));
    border: 1px solid var(--brand-surface-line);
    text-align: center;
  }
  .cta h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--landing-heading);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    text-wrap: balance;
  }
  .cta p { max-width: 36rem; margin: 0.75rem auto 0; line-height: 1.6; color: var(--muted-foreground); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.75rem; }
  .action {
    display: inline-flex;
    align-items: center;
    min-height: 2.875rem;
    padding: 0 1.4rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }
  .action.primary { background: linear-gradient(90deg, var(--brand-button-from), var(--brand-button-to)); color: var(--brand-button-text); }
  .action.secondary { border: 1px solid var(--brand-surface-line); background: var(--brand-surface); color: var(--foreground); }
  .action.secondary:hover { border-color: var(--brand-accent); }
  .action:focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }

  .landing-footer {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
    max-width: 72rem;
    margin: clamp(3.5rem, 8vh, 5rem) auto 0;
    padding: 2.5rem 1.5rem 1.5rem;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 52rem) {
    .landing-footer { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .brand { grid-column: 1 / -1; }
  }
  .brand p { margin: 0.75rem 0 0; color: var(--muted-foreground); line-height: 1.6; }
  .brand .company { max-width: 26rem; font-size: 0.9rem; }
  .brand-link { text-decoration: none; }
  .brand-link .brand-wordmark { font-size: 1.35rem; }
  .brand-link:focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
  nav h2 {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  li { margin: 0; }
  nav a { color: var(--foreground); text-decoration: none; }
  nav a:hover { color: var(--brand-accent); }
  nav a:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
  .legal { grid-column: 1 / -1; margin: 1rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--muted-foreground); }
</style>
