---
// The landing stage: one device from firmware to an alarm, as a Three.js illustration
// with a ribbon that says what the platform is doing at that moment (src/scripts/stage).
// The captions are real text and complete without JavaScript: a numbered list under the
// picture. With motion they become the ribbon, one at a time. Motion plays when the
// stage scrolls into view, pauses off screen and has a pause button; with reduced
// motion the stage shows one still moment.
import { docsConfig } from '../../../docs.config'
import { beats, captions } from '../../scripts/stage/timeline'
---

<section class="stage not-content reveal" aria-labelledby="stage-title">
  <div class="stage-head">
    <p class="kicker">See it work</p>
    <h2 id="stage-title">From a board on the bench to an alarm on the wall</h2>
    <p class="intro">
      One device, start to finish: its firmware, its connection, a dashboard and an automation. An illustration of
      the real steps, played in about twenty seconds.
    </p>
  </div>

  <div class="frame" data-stage-frame>
    <div class="toolbar">
      <ol class="beats" aria-label="Steps">
        {
          beats.map((beat, index) => (
            <li>
              <button type="button" class="beat" data-beat={beat.id} data-start={beat.start} disabled>
                <span class="beat-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                {beat.label}
                <span class="beat-progress" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ol>
      <span class="badge">Illustration</span>
      <button type="button" class="pause" data-pause aria-pressed="false" hidden>
        <span class="pause-icon" aria-hidden="true"></span>
        <span data-pause-label>Pause</span>
      </button>
    </div>

    <div class="scene" data-scene-host>
      <canvas data-stage-canvas aria-hidden="true"></canvas>
      <div class="labels" aria-hidden="true">
        <span class="label" data-label="device"><span class="dot"></span>cold-room-1</span>
        <span class="label" data-label="platform"><span class="dot"></span>{docsConfig.productName}</span>
        <span class="label" data-label="dashboard"><span class="dot"></span>Cold room dashboard</span>
        <span class="label" data-label="alarm"><span class="dot"></span>Alarm</span>
        <span class="label" data-label="phone"><span class="dot"></span>SMS</span>
        <span class="label" data-label="mail"><span class="dot"></span>Inbox</span>
        <div class="bubble" data-bubble>
          <span class="bubble-from">Text message · now</span>
          <span class="bubble-text">Cold room too warm: 8.6 °C for 5 minutes. cold-room-1</span>
        </div>
      </div>
      <p class="sr-only">
        Illustration: an ESP32 board receives a firmware starter and is flashed. Readings travel from the board to
        {docsConfig.productName}, then on to a Cold room dashboard whose temperature chart fills in. The temperature
        climbs past 8 °C: an automation lights an alarm dome on the floor, a phone comes in with a text message
        reading "Cold room too warm: 8.6 °C for 5 minutes", and an inbox shows the same alert as an email.
      </p>
    </div>

    <ol class="captions" data-captions aria-label="What happens">
      {
        captions.map((caption, index) => (
          <li class="caption" data-at={caption.at}>
            <span class="caption-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="caption-text">{caption.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // The scene loads when the stage comes near the viewport, so it never competes with
  // the hero for the first paint.
  const frame = document.querySelector<HTMLElement>('[data-stage-frame]')
  if (frame) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        observer.disconnect()
        import('../../scripts/stage/play').then(({ playStage }) => playStage(frame)).catch(() => undefined)
      },
      { rootMargin: '300px 0px' },
    )
    observer.observe(frame)
  }
</script>

<style>
  .stage {
    max-width: 76rem;
    margin: clamp(4rem, 10vh, 6.5rem) auto 0;
    padding-inline: 1.5rem;
  }
  .stage-head { max-width: 46rem; }
  .kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-accent);
  }
  h2 {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: var(--landing-heading);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    text-wrap: balance;
  }
  .intro {
    margin: 0.85rem 0 0;
    color: var(--muted-foreground);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .frame {
    --stage-height: clamp(28rem, 62vh, 36rem);
    position: relative;
    margin-top: 2rem;
    border: 1px solid var(--brand-surface-line);
    border-radius: 1.1rem;
    background: color-mix(in oklab, var(--brand-surface) 82%, transparent);
    box-shadow: 0 1.5rem 3.5rem -2rem color-mix(in oklab, var(--brand-from) 45%, transparent);
    overflow: hidden;
  }

  /* ---------- Toolbar: the steps, the label and the pause button ---------- */
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--brand-surface-line);
  }
  .beats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    flex: 1 1 auto;
  }
  .beats li { margin: 0; }
  .beat {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    font: 500 0.875rem/1 var(--font-display);
    color: var(--muted-foreground);
    cursor: pointer;
    overflow: hidden;
    transition:
      color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard);
  }
  .beat:disabled { cursor: default; }
  .beat:not(:disabled):hover { color: var(--foreground); }
  .beat[aria-current="step"] {
    border-color: var(--brand-surface-line);
    background: color-mix(in oklab, var(--brand-mid) 12%, transparent);
    color: var(--foreground);
  }
  .beat:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
  .beat-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--brand-accent);
  }
  .beat-progress {
    position: absolute;
    inset: auto 0.8rem 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-from), var(--brand-to));
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    opacity: 0;
  }
  .beat[aria-current="step"] .beat-progress { opacity: 1; }

  .badge {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--brand-surface-line);
    border-radius: 999px;
    font: 500 0.75rem/1.4 var(--font-mono);
    color: var(--muted-foreground);
  }
  .pause {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--brand-surface-line);
    border-radius: 999px;
    background: none;
    font: 500 0.875rem/1 var(--font-display);
    color: var(--foreground);
    cursor: pointer;
  }
  .pause[hidden] { display: none; }
  .pause:hover { border-color: var(--brand-accent); }
  .pause:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
  .pause-icon {
    width: 0.6rem;
    height: 0.7rem;
    border-inline: 0.2rem solid currentColor;
  }
  .pause[aria-pressed="true"] .pause-icon {
    width: 0;
    height: 0;
    border-block: 0.38rem solid transparent;
    border-inline: 0.62rem solid currentColor;
    border-inline-end-width: 0;
  }

  /* ---------- The scene ---------- */
  /* A fixed height, not an aspect ratio: with a minimum height an aspect ratio would
     set a minimum width too, wider than a phone. */
  .scene {
    position: relative;
    display: none;
    min-width: 0;
    height: 18rem;
    background:
      radial-gradient(ellipse 70% 60% at 50% 45%, var(--brand-glow), transparent 75%),
      linear-gradient(180deg, var(--brand-hero-from), var(--brand-hero-to));
  }
  .frame[data-scene] .scene { display: block; }
  .scene canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .labels { position: absolute; inset: 0; pointer-events: none; }
  .label {
    position: absolute;
    top: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--brand-surface-line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--brand-surface) 88%, transparent);
    font: 500 0.75rem/1.3 var(--font-mono);
    color: var(--foreground);
    white-space: nowrap;
    /* The scene places each label over its object and shows it once the object is there. */
    opacity: 0;
    transition: opacity 300ms var(--ease-standard);
  }
  .label .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--muted-foreground);
  }
  /* The text message, readable beside the phone: its tail points at the phone. */
  .bubble {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: max-content;
    max-width: min(15rem, 46vw);
    padding: 0.55rem 0.8rem 0.6rem;
    border: 1px solid var(--brand-surface-line);
    border-radius: 1rem 1rem 0.3rem 1rem;
    background: color-mix(in oklab, var(--brand-surface) 94%, transparent);
    box-shadow: 0 0.75rem 1.5rem -0.75rem color-mix(in oklab, var(--brand-from) 50%, transparent);
    color: var(--foreground);
    opacity: 0;
    transform-origin: 100% 50%;
    transition:
      opacity 320ms var(--ease-standard),
      scale 320ms var(--ease-standard);
    scale: 0.85;
  }
  .bubble[data-shown] { opacity: 1; scale: 1; }
  .bubble::after {
    content: '';
    position: absolute;
    right: -0.45rem;
    top: 50%;
    border: 0.45rem solid transparent;
    border-left-color: var(--brand-surface-line);
    border-right: 0;
    transform: translateY(-50%);
  }
  .bubble-from {
    font: 500 0.7rem/1.3 var(--font-mono);
    color: var(--muted-foreground);
  }
  .bubble-text {
    font-size: 0.875rem;
    line-height: 1.4;
    text-wrap: pretty;
  }
  @media (max-width: 55.99rem) {
    .bubble { padding: 0.45rem 0.65rem 0.5rem; }
    .bubble-text { font-size: 0.8125rem; }
  }

  .label[data-state="active"] .dot { background: var(--brand-to); }
  .label[data-state="success"] .dot { background: var(--success); }
  .label[data-state="warning"] .dot { background: var(--warning); }

  /* ---------- The captions: a list, or the ribbon while it plays ---------- */
  .captions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 1rem 1.1rem 1.1rem;
    list-style: none;
    border-top: 1px solid var(--brand-surface-line);
  }
  .caption {
    display: flex;
    gap: 0.7rem;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--foreground);
    text-wrap: pretty;
  }
  .caption-number {
    flex: none;
    padding-top: 0.15em;
    font: 500 0.75rem/1.5 var(--font-mono);
    color: var(--brand-accent);
  }
  .frame[data-motion] .captions {
    display: grid;
    min-height: 5.2rem;
    padding: 0.9rem 1.1rem 1rem;
  }
  /* The steps carry the numbers while it plays. */
  .frame[data-motion] .caption-number { display: none; }
  .frame[data-motion] .caption {
    grid-area: 1 / 1;
    max-width: 44rem;
    transition:
      opacity 420ms var(--ease-standard),
      transform 420ms var(--ease-standard);
  }
  .frame[data-motion] .caption:not([data-current]) {
    opacity: 0;
    transform: translateY(0.45rem);
    pointer-events: none;
  }

  @media (min-width: 56rem) {
    .frame[data-scene] .scene { height: var(--stage-height); }
    /* On a wide screen the ribbon lies over the bottom of the picture. */
    .frame[data-motion][data-scene] .captions {
      position: absolute;
      inset: auto 0 0;
      min-height: 0;
      padding: 2.4rem 1.5rem 1.1rem;
      border-top: 0;
      background: linear-gradient(180deg, transparent, color-mix(in oklab, var(--brand-hero-to) 92%, transparent) 45%);
    }
    .frame[data-motion][data-scene] .caption { font-size: 1.0625rem; }
  }
</style>
