.DS_Store
.env
.tools/

# Agent tool state: worktrees and personal settings stay local; shared
# .claude/ commands and skills are committed.
.claude/worktrees/
.claude/settings.local.json
.kilo/
**/.codex/

# Generated screenshots and scratch output
/output/

__pycache__/

node_modules/
.turbo/
coverage/
dist/
# Contract bundles and API references, built in CI and never committed.
contracts/openapi/dist/
*.tsbuildinfo
playwright-report/
test-results/
.serena/

vendor/

*.test
*.out

deploy/compose/data/

# Private credentials, environment files, database dumps, release evidence and
# adapter state. Nothing under .local/ is ever committed.
.local/

# Storybook build output
storybook-static/

# Docs site (apps/docs): sources extracted from the hosted commit, the guide pages
# generated from them, the simulator kit, Astro's generated types and Lighthouse
# output. Real values live in .local/docs/, never in the app folder.
apps/docs/.sources/
apps/docs/src/content/docs/docs/guides/
apps/docs/public/downloads/
apps/docs/.astro/
apps/docs/.lighthouseci/
apps/docs/.env*
