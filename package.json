{
  "name": "iot-os",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "contracts:check": "pnpm --filter @iot-os/contracts check",
    "contracts:generate": "pnpm --filter @iot-os/api-client generate:device-domain",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  }
}
