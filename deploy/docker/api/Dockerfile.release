FROM php:8.4-fpm-bookworm AS api
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev libzip-dev unzip curl poppler-utils \
    && docker-php-ext-install pdo_pgsql pcntl opcache \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
COPY apps/api/composer.json apps/api/composer.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader
COPY apps/api ./
RUN php artisan help:validate
COPY contracts /var/contracts
COPY deploy/docker/api/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY deploy/docker/api/release.ini /usr/local/etc/php/conf.d/release.ini
RUN composer dump-autoload --no-dev --optimize \
    && mkdir -p storage/app/private storage/app/public storage/framework/cache storage/framework/sessions storage/framework/views bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache
USER www-data
EXPOSE 9000
CMD ["php-fpm", "-F"]

FROM nginx:1.29-alpine AS api-web
COPY --from=api /var/www/html/public /var/www/html/public
COPY deploy/docker/api/nginx.release.conf /etc/nginx/conf.d/default.conf
