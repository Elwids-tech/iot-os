{
  "format": 1,
  "config": {
    "app.frontend_url": "https://app.{domain}",
    "agents.resource": "https://api.{domain}/mcp",
    "passkeys.relying_party_id": "{domain}"
  },
  "routes": [
    "PUT api/v1/admin/super-administrators/{user}",
    "DELETE api/v1/admin/super-administrators/{user}",
    "POST api/v1/admin/super-administrators/invitations",
    "PUT api/v1/admin/platform-team/{user}",
    "DELETE api/v1/admin/organizations/{organization}",
    "GET api/v1/notifications/push",
    "POST api/v1/notifications/push/devices",
    "POST api/v1/auth/two-step",
    "GET api/v1/auth/passkeys/options",
    "POST api/v1/auth/passkeys",
    "POST api/v1/auth/confirm-password",
    "GET api/v1/auth/confirm-passkey/options",
    "POST api/v1/auth/confirm-passkey",
    "GET api/v1/me/security",
    "POST api/v1/me/two-step",
    "POST api/v1/me/two-step/confirm",
    "POST api/v1/me/two-step/recovery-codes",
    "DELETE api/v1/me/two-step",
    "GET api/v1/me/passkeys/options",
    "POST api/v1/me/passkeys",
    "DELETE api/v1/me/passkeys/{passkey}",
    "GET api/v1/organizations/{organization}/security",
    "PUT api/v1/organizations/{organization}/security",
    "POST api/v1/admin/users/{user}/two-step/reset",
    "GET api/v1/portal/runtime-config.js",
    "GET api/internal/portal-addresses/ask",
    "PUT api/v1/billing-accounts/{billingAccount}/addresses/name",
    "GET api/v1/sign-up",
    "POST api/v1/sign-up",
    "GET api/v1/sign-up/status",
    "POST api/v1/sign-up/resend",
    "POST api/v1/sign-up/confirm",
    "GET api/v1/admin/sign-up-settings",
    "PUT api/v1/admin/sign-up-settings",
    "GET api/v1/admin/sign-ups"
  ],
  "named_routes": [
    "api.v1.admin.assistant-settings.show",
    "api.v1.admin.assistant-settings.update",
    "api.v1.admin.assistant-settings.keys.destroy",
    "api.v1.admin.assistant-settings.test",
    "api.v1.admin.billing-plans.index",
    "api.v1.admin.billing.settings.show",
    "api.v1.admin.billing.invoices.issue",
    "api.v1.billing-accounts.usage.show",
    "api.v1.billing-accounts.invoices.checkout.returned",
    "stripe.webhook"
  ],
  "tables": [
    "assistant_settings", "assistant_provider_keys",
    "billing_plans", "billing_plan_allowances", "billing_plan_assignments", "billing_usage",
    "billing_invoices", "billing_payments", "billing_provider_events",
    "kept_sign_ins", "push_devices", "push_organization_mutes", "push_summaries",
    "passkeys", "sign_ups", "sign_up_settings",
    "brands", "brand_assets", "portal_addresses"
  ],
  "columns": {
    "organization_invitations": ["grants_super_admin"],
    "billing_accounts": ["past_due_since", "pm_saved_at"],
    "devices": ["limit_place_at"],
    "automation_alert_deliveries": ["devices_total", "devices_reached", "push_summary_id"],
    "notification_preferences": ["push_enabled", "push_levels", "push_revision"],
    "users": ["two_factor_secret", "two_factor_recovery_codes", "two_factor_confirmed_at"],
    "organizations": ["two_step_required"],
    "portal_addresses": ["allowance_off_since"]
  }
}
