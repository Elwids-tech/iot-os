{
    email {$ACME_EMAIL}
}
app.{$DOMAIN} {
    encode gzip
    reverse_proxy portal:80
}
admin.{$DOMAIN} {
    encode gzip
    reverse_proxy admin:80
}
api.{$DOMAIN} {
    @internal path /internal/* /api/internal/*
    respond @internal 404
    reverse_proxy api-web:80
}
ops.{$DOMAIN} {
    @vpn remote_ip {$VPN_CIDR}
    handle @vpn {
        reverse_proxy grafana:3000
    }
    respond 403
}
