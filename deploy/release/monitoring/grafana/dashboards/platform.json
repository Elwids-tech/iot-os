{
  "uid": "iot-platform",
  "title": "IoT platform health",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Memory available (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 2,
      "title": "CPU busy (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 3,
      "title": "Disk free (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 4,
      "title": "Worker heartbeat age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - iot_worker_heartbeat_timestamp_seconds",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 5,
      "title": "Simulator freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - iot_simulator_oldest_observation_timestamp_seconds",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 6,
      "title": "Queues",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "iot_queue_depth",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 7,
      "title": "Durable outbox",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "iot_runtime_outbox_pending",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 8,
      "title": "PostgreSQL bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "iot_postgres_database_bytes",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 9,
      "title": "Backup age (hours)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(time() - iot_backup_success_timestamp_seconds) / 3600",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 10,
      "title": "Container restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "iot_container_restarts_total",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 11,
      "title": "AI allowance used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "iot_assistant_spent_usd + iot_assistant_reserved_usd",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 12,
      "title": "Workflow executions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "iot_workflow_executions",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 20,
      "title": "Service logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{job=\"containers\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 30,
      "title": "API server error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(iot_http_requests_window{status_class=\"5xx\"}) / clamp_min(sum(iot_http_requests_window),1)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 31,
      "title": "API average latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(iot_http_duration_window_seconds) / clamp_min(sum(iot_http_requests_window),1)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 38,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 32,
      "title": "Messaging pending",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "iot_nats_consumer_pending",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 38,
        "w": 8,
        "h": 7
      }
    }
  ]
}
