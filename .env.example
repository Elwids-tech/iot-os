# Development-only values. Never reuse these credentials in production.
IOT_COMPOSE_PROJECT_NAME=iot-os-dev

IOT_POSTGRES_IMAGE=timescale/timescaledb:2.29.2-pg17
IOT_POSTGRES_DATABASE=iot_os
IOT_POSTGRES_USER=iot_os
IOT_POSTGRES_PASSWORD=iot_os_dev_only
IOT_POSTGRES_PORT=5432

IOT_REDIS_IMAGE=redis:8.8.2-alpine
IOT_REDIS_PORT=6380

IOT_NATS_IMAGE=nats:2.14.5-alpine
IOT_NATS_CLIENT_PORT=4222
IOT_NATS_MONITOR_PORT=8222

IOT_EMQX_IMAGE=emqx/emqx:5.9.3
IOT_EMQX_COOKIE=iot_os_dev_cookie_only
IOT_EMQX_DASHBOARD_USER=admin
IOT_EMQX_DASHBOARD_PASSWORD=iot_os_dev_only
IOT_MQTT_PORT=1883
IOT_MQTT_WEBSOCKET_PORT=8083
IOT_EMQX_DASHBOARD_PORT=18083

IOT_NODE_RED_IMAGE=nodered/node-red:4.1.13-22
IOT_NODE_RED_CREDENTIAL_SECRET=iot_os_dev_only
IOT_NODE_RED_PORT=1880

IOT_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
IOT_MINIO_ROOT_USER=iot_os
IOT_MINIO_ROOT_PASSWORD=iot_os_dev_only
IOT_MINIO_API_PORT=9000
IOT_MINIO_CONSOLE_PORT=9001

IOT_MAILPIT_IMAGE=axllent/mailpit:v1.27.7
IOT_MAILPIT_UI_PORT=8025

IOT_RUNTIME_HTTP_ADDRESS=:8081
IOT_API_PORT=8001
IOT_ADMIN_PORT=5174
IOT_PORTAL_PORT=5173
IOT_PORTAL_URL=http://127.0.0.1:5173
IOT_ADMIN_URL=http://127.0.0.1:5174
IOT_API_URL=http://127.0.0.1:8001
# Development-only Laravel key for the Docker application profile.
IOT_API_APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optional Devices TLS overlay. Private credentials live in .local/devices/devices.env.
IOT_MQTTS_PORT=8883

# Contextual guides work without AI. Enable Ask Help after evaluation.
IOT_HELP_AI_ENABLED=false

# Vendor MQTT adapters: enable using compose.adapters.yml after private setup.
IOT_ADAPTERS_ENABLED=false
IOT_ADAPTER_MANAGER_TOKEN=
IOT_ADAPTER_HOST_STATE_DIR=
IOT_ADAPTER_DOCKER_NETWORK=iot-os-dev_internal
IOT_ADAPTER_PUBLIC_HOST=localhost
IOT_ADAPTER_BIND_ADDRESS=127.0.0.1
IOT_ADAPTER_PORT_BASE=19000
IOT_ADAPTER_PORT_LIMIT=19999
